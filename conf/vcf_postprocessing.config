/*
 * tronflow-vcf-postprocessing sub-pipeline resource hints.
 * VAFATOR is the slow step — 72h wall time is intentional for WGS.
 * Override for WES:   params { vcf_post_cpus = 8;  vcf_post_memory = '32.GB' }
 * Override for panel: params { vcf_post_cpus = 4;  vcf_post_memory = '16.GB' }
 */

params {
    vcf_post_cpus   = 16
    vcf_post_memory = '64.GB'
}

process {
    withName: 'VAFATOR' {
        time = { 72.h * task.attempt }
    }
}