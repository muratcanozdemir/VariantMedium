/*
 * VariantMedium process resource configuration
 * Default labels follow nf-core conventions for HPC portability.
 * Override per-site via a custom config passed with -c.
 *
 * Sequencing mode defaults (WGS):
 *   params.seq_mode = 'wgs'   -> uses full resource allocations below
 *   params.seq_mode = 'wes'   -> override in site config or params file
 *   params.seq_mode = 'panel' -> override in site config or params file
 *
 * Recommended WES overrides:
 *   process { withLabel: process_high { cpus = 8; memory = 48.GB } }
 *
 * Recommended panel overrides:
 *   process { withLabel: process_high { cpus = 4; memory = 24.GB } }
 */

process {

    cpus          = { 1    * task.attempt }
    memory        = { 6.GB * task.attempt }
    time          = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + [104, 175]) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1 }
        memory = { 6.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // used by external sub-pipeline launcher processes — runs on the submit node,
    // not dispatched to SLURM, wall time covers the full child pipeline duration
    withLabel: process_local {
        cpus     = 1
        memory   = '1.GB'
        time     = '72.h'
        executor = 'local'
    }

    withLabel: process_low {
        cpus   = { 2  * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 6  * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 12  * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withLabel: process_high_memory {
        cpus   = { 12  * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }

    withLabel: process_gpu {
        ext.use_gpu  = { workflow.profile.contains('gpu') }
        accelerator  = { workflow.profile.contains('gpu') ? 1 : null }
    }

    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}