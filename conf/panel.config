// panel.config — pass with -c conf/panel.config for targeted panel runs
params {
    seq_mode          = 'panel'
    bam2tensor_cpus   = 4
    bam2tensor_memory = '16.GB'
    strelka2_cpus     = 4
    strelka2_memory   = '16.GB'
    vcf_post_cpus     = 4
    vcf_post_memory   = '16.GB'
}

process {
    withLabel: process_high {
        cpus   = { 4  * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high_memory {
        cpus   = { 4  * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 2  * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_local {
        cpus     = 1
        memory   = '1.GB'
        time     = '24.h'    // panel runs are fast — child pipelines finish sooner
        executor = 'local'
    }
}