/*
 * bam2tensor sub-pipeline resource hints.
 * Passed to the child pipeline via --cpus and --memory params.
 * Override for WES:  params { bam2tensor_cpus = 8; bam2tensor_memory = '32.GB' }
 * Override for panel: params { bam2tensor_cpus = 4; bam2tensor_memory = '16.GB' }
 */

params {
    bam2tensor_cpus   = 16
    bam2tensor_memory = '64.GB'
}