/*
 * TRON-Bioinformatics/variantmedium
 */

params {
    // required
    samplesheet            = null
    outdir                 = null

    external {
        bam_preprocessing_version  = 'v2.1.0'
        strelka2_version           = 'v0.2.4'
        vcf_postprocessing_version = 'v3.1.2'
        bam2tensor_version         = '1.0.2'
    }

    // calling options
    snv_calling            = true
    indel_calling          = false
    skip_preprocessing     = false

    // data staging
    run_data_staging       = true
    bed_url                = "http://hgdownload.soe.ucsc.edu/gbdb/hg38/exomeProbesets/S07604624_Covered.bb"
    reference_dir          = 'ref_data'
    models_dir             = 'models'

    // output directory names
    prepare_tsv_outs          = 'tsv_folder'
    data_staging_outs         = 'data_staging'
    preprocess_outs           = 'output_01_01_preprocessed_bams'
    candidate_calling_outs    = 'output_01_02_candidate_calls'
    vcf_postprocessing_outs   = 'output_01_03_vcf_postprocessing'
    candidate_filtering_outs  = 'output_01_04_candidates_extratrees'
    bam2tensor_outs           = 'output_01_05_tensors'
    variant_calling_outs      = 'output_01_06_calls_densenet'
    publish_dir_mode          = 'copy'

    // variantmedium model hyperparams (inference only — do not change without retraining)
    learning_rate             = 0.13
    drop_rate                 = 0.3
    epoch                     = 0

    // container images — override in your site config
    container_base            = 'ghcr.io/tron-bioinformatics/variantmedium-base:1.2.0'
    container_ml              = 'ghcr.io/tron-bioinformatics/variantmedium-ml:1.2.0'

    version                   = '1.2.0'
    // skip flags
    skip_preprocessing        = false
    skip_candidate_calling    = false
    skip_feature_generation   = false
    skip_candidate_filtering  = false
    skip_tensor_generation    = false

    // resume child pipelines
    resume                    = false

    // profile to pass through to child pipelines
    nf_profile                = 'conda'

    // custom configs for external sub-pipelines
    bam_prep_config           = null
    strelka_config            = null
    vcf_post_config           = null
    bam2tensor_config         = null

    // reference paths (populated by data staging, or overridden via config)
    ref                       = null
    exome_bed                 = null
    dbsnp                     = null
    known_indels1             = null
    known_indels2             = null

    // sequencing mode — affects resource allocation guidance only,
    // not pipeline logic. Actual overrides must be set explicitly.
    // valid: wgs, wes, panel
    seq_mode = 'wgs'

    // sub-pipeline resource params (see conf/*.config for per-mode guidance)
    bam2tensor_cpus   = 16
    bam2tensor_memory = '64.GB'
    strelka2_cpus     = 16
    strelka2_memory   = '64.GB'
    vcf_post_cpus     = 16
    vcf_post_memory   = '64.GB'

    // model provenance — pinned HuggingFace commit SHAs
    // update atomically with sha256 checksums on every model release
    // obtain SHA: huggingface.co/tron-mainz/<repo>/commits/main
    model_commit_snv                = "REPLACE_WITH_HF_COMMIT_SHA"
    model_commit_indel              = "REPLACE_WITH_HF_COMMIT_SHA"
    model_commit_extra_trees_snv    = "REPLACE_WITH_HF_COMMIT_SHA"
    model_commit_extra_trees_indel  = "REPLACE_WITH_HF_COMMIT_SHA"

    // SHA-256 checksums — verify with: sha256sum <file>
    model_sha256_snv                = "REPLACE_WITH_SHA256"
    model_sha256_indel              = "REPLACE_WITH_SHA256"
    model_sha256_extra_trees_snv    = "REPLACE_WITH_SHA256"
    model_sha256_extra_trees_indel  = "REPLACE_WITH_SHA256"
}

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    beforeScript  = 'echo SLURM_JOB_ID=$SLURM_JOB_ID'

    cpus          = { 1    * task.attempt }
    memory        = { 6.GB * task.attempt }
    time          = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + [104, 175]) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'
}

profiles {
    conda {
        conda.enabled = true
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '--rm'
        docker.userEmulation   = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = params.mount_path ? "--bind ${params.mount_path}" : ""
    }

    slurm {
        process.executor = 'slurm'
    }

    gpu {
        process.containerOptions = '--gpus all'
    }

    // disable intermediate file cleanup during development
    dev {
        cleanup = false
    }
    test {
        params {
            samplesheet = "${projectDir}/tests/samplesheet.test.tsv"
            outdir      = "/tmp/variantmedium_test_${new java.util.Date().getTime()}"
            seq_mode    = 'wgs'
        }
        // activate stub mode for all processes
        process.stub = true
    }

    test_ci {
        // identical to test but with a fixed outdir for artifact collection
        params {
            samplesheet = "${projectDir}/tests/samplesheet.test.tsv"
            outdir      = "/tmp/variantmedium_test_ci"
            seq_mode    = 'wgs'
        }
        process.stub = true
    }
}

// cleanup only in non-dev runs
cleanup = true

manifest {
    name            = 'TRON-Bioinformatics/variantmedium'
    homePage        = 'https://github.com/TRON-Bioinformatics/variantmedium'
    description     = 'Somatic point mutation calling using 3D DenseNets'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.3'
    version         = "${params.version}"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/bam2tensor.config'
includeConfig 'conf/strelka.config'
includeConfig 'conf/vcf_postprocessing.config'